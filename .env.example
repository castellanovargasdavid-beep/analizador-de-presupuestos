DATABASE_URL="postgres://postgres:postgres@localhost:5432/presupuesto_claro"

# Panel /admin: un único operador, sin sistema de usuarios (ver lib/admin/auth.ts).
# Genera un valor real para ADMIN_SESSION_SECRET, por ejemplo con:
#   openssl rand -hex 32
ADMIN_PASSWORD="cambia-esto"
ADMIN_SESSION_SECRET="cambia-esto-tambien-por-un-valor-aleatorio-largo"

# Autenticación del portal de profesional (mismo patrón que el admin).
PROFESSIONAL_SESSION_SECRET="genera-otro-valor-aleatorio-largo-distinto-del-de-admin"

# Protege /api/cron/lead-deadlines: sin esto definido, el endpoint rechaza
# cualquier petición. En Vercel, configúralo también como cabecera
# Authorization: Bearer <valor> en el cron job (ver docs/PRODUCTION-SETUP.md).
CRON_SECRET="genera-un-valor-aleatorio-largo"

# Adaptador de notificaciones activo. "mock" (por defecto) nunca envía nada
# de verdad — ver docs/NOTIFICATION-SYSTEM.md para configurar un proveedor real.
NOTIFICATION_ADAPTER="mock"

# Plazos del ciclo de vida del lead (horas). Opcionales: si no se definen,
# se usan los valores por defecto de lib/leads/deadline-config.ts.
# CONTACT_CONFIRMATION_DEADLINE_HOURS="4"
# CONTACT_WARNING_DELAY_HOURS="1"
# CONTACT_GRACE_PERIOD_HOURS="2"
# QUOTE_SUBMISSION_DEADLINE_HOURS="72"
# QUOTE_WARNING_DELAY_HOURS="12"
# QUOTE_GRACE_PERIOD_HOURS="24"
# REASSIGNMENT_COOLDOWN_HOURS="1"
# PROFESSIONAL_RESPONSE_WINDOW_HOURS="2"
